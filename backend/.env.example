# Đổi tên file này thành .env và điền thông tin thật
# Connection string lấy từ MongoDB Atlas (Connect -> Drivers)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/shopdb?retryWrites=true&w=majority

# Cổng chạy server (Cloud Run sẽ tự set PORT, để 8080 khi deploy)
PORT=5000
